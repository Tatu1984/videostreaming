# Live Feed Portal — environment (all optional; sensible defaults apply)

# Base URL of the media INGEST that serves HLS playlists/segments. Used only by
# the seed cameras to build placeholder hlsUrls. Real cameras carry full hlsUrls
# in the registry, so this is only relevant on first-run seeding.
NEXT_PUBLIC_INGEST_BASE=http://localhost:3000

# Where the portal stores its camera registry (writable dir). Defaults to ./data.
# On a read-only/serverless FS (e.g. Vercel), the portal falls back to in-memory
# and you should provide the registry via CAMERAS_JSON below instead.
# LIVEFEED_DATA_DIR=/var/lib/live-feed

# Provide the entire camera registry inline as JSON (overrides the data file).
# Ideal for serverless deploys where the filesystem is not persistent.
# CAMERAS_JSON=[{"id":"cam-001","name":"Front","hlsUrl":"https://ingest.example.com/api/edge/ingest/cam-001/index.m3u8"}]

# If set, editing the registry (POST/DELETE /api/admin/cameras) requires
# Authorization: Bearer <token>. If unset, the admin API is open (dev/local only).
# Viewing the portal is ALWAYS unauthenticated by design.
# LIVEFEED_ADMIN_TOKEN=change-me

# Timeout (ms) for the server-side HLS liveness probe.
# LIVEFEED_CHECK_TIMEOUT_MS=3000

# ─────────────────────────────────────────────────────────────────────────────
# MEDIA / HLS INGEST  (where the Edge Agent PUTs video and browsers fetch it)
# ─────────────────────────────────────────────────────────────────────────────

# Backend: "r2" (Cloudflare R2 — scale/production, works on Vercel) or "fs"
# (local disk — dev or a single VM). Default: fs.
# MEDIA_BACKEND=r2

# Token the Edge Agent must send to upload (Authorization: Bearer <token>).
# Paste the SAME value into the Edge Agent's Portal Connection "Token" field.
# If unset, uploads are open (dev only).
# EDGE_INGEST_TOKEN=change-me-strong-random

# --- Cloudflare R2 settings (required when MEDIA_BACKEND=r2) ---
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET=live-feed-hls
# R2_PREFIX=hls
# Public/CDN base for reads. Set this to your R2 public bucket URL or a custom
# domain in front of R2 (recommended). When set, playback redirects the browser
# straight to the CDN — segment bytes never pass through this app (best at scale).
# R2_PUBLIC_BASE=https://media.your-domain.com

# --- Local FS settings (when MEDIA_BACKEND=fs) ---
# MEDIA_FS_DIR=./.media
