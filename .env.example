# Live Feed Portal — environment

# ── Auth + Database (REQUIRED) ───────────────────────────────────────────────

# Neon Postgres connection string (Settings → Connection string in Neon).
# Use the POOLED connection string for serverless/Vercel.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session cookies (JWT). Use a long random string:
#   openssl rand -hex 32
AUTH_SECRET=paste-a-long-random-string-here

# Public base URL of this app — used to build the ingest/playback URLs shown to
# the operator. On Vercel set it to your deployment URL / custom domain.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Media / HLS storage (REQUIRED for real video) ────────────────────────────

# Backend: "r2" (Cloudflare R2 — production, works on Vercel) or "fs" (local
# disk — dev only). Default: fs.
MEDIA_BACKEND=r2

# Cloudflare R2 (required when MEDIA_BACKEND=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=cctv-streaming
R2_PREFIX=hls
# NOTE: playback is per-user PRIVATE, so it is served through the app (ownership
# is checked). A public CDN URL would bypass that check, so R2_PUBLIC_BASE is NOT
# used for playback here — it is intentionally omitted. (Segments are still
# stored in R2 with immutable cache headers for internal efficiency.)

# Local FS backend (when MEDIA_BACKEND=fs, dev only)
# MEDIA_FS_DIR=./.media

# ── Optional ─────────────────────────────────────────────────────────────────
# LIVEFEED_CHECK_TIMEOUT_MS=3000   # HLS liveness probe timeout
